// Local testing config for development

params {
    // Input data paths
    input_fasta        = "${projectDir}/reference_data/filtered_contig.fasta"
    input_annotations  = "${projectDir}/reference_data/filtered_contig_annotations.csv"
    reference_data     = "${projectDir}/reference_data/BCR_data.tsv"
    
    // Output directory
    outdir             = "${projectDir}/results"
    
    // Pipeline licenses
    mixcr_license      = "REDACTED-use-nextflow-secret-MI_LICENSE"
    
    // CellRanger configuration
    cellranger_run_id  = "HumanB_Cell_multi"
    
    // SRA download parameters (decoupled, reserved for future use)
    subsample_reads    = 1000
    subsample_seed     = 42
}

docker {
    enabled = true
}

process {
    // Immcantation process
    withName: 'RUN_IMMCANTATION' {
        container = 'immcantation/suite:4.4.0'
        cpus = 4
        memory = '8 GB'
    }
    
    // Comparison analysis process
    withName: 'COMPARE_RESULTS' {
        container = 'rocker/tidyverse:latest'
        cpus = 2
        memory = '4 GB'
    }
    
    // CellRanger multi pipeline process
    withName: 'RUN_CELLRANGER' {
        container = 'ubuntu:22.04'
        cpus = 8
        memory = '16 GB'
        containerOptions = "--bind ${projectDir}/bin/cellranger-10.0.0:/opt/cellranger-10.0.0:ro"
        shell = ['/bin/sh', '-e']
    }
    
    // CellRanger data download process
    withName: 'DOWNLOAD_CELLRANGER_DATA' {
        container = 'ubuntu:22.04'
        cpus = 2
        memory = '8 GB'
    }
    
    // MixCR analysis process
    withName: 'RUN_MIXCR' {
        container = 'ghcr.io/milaboratory/mixcr/mixcr:4.7.0'
        cpus = 8
        memory = '16 GB'
        containerOptions = '--no-home --writable-tmpfs'
    }
    
    // SRA download process (currently decoupled)
    withName: 'RUN_SRA_DOWNLOAD' {
        container = 'paulpyl/sra-tools_bash:latest'
        cpus = 4
        memory = '8 GB'
    }
}

// Disable apptainer, enable docker
apptainer {
    enabled = false
}
