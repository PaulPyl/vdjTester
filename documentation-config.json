      "container": "immcantation/suite:4.4.0",
      "documentationUrl": "https://immcantation.readthedocs.io/",
      "githubUrl": "https://github.com/immcantation/immcantation",
      "docs": {
        "install": "https://immcantation.readthedocs.io/en/latest/install.html",
        "apiReference": "https://immcantation.readthedocs.io/en/latest/api.html",
