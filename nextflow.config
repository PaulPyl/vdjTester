// vdjTester: compare VDJ callers (Cell Ranger multi, Immcantation, MiXCR) on one 10x
// sample, and check their calls against B/T identity from the matched expression data.
//
// Profiles:
//   -profile test     stub runs on the laptop, no containers (use with -stub)
//   -profile dardel   Slurm + Apptainer on PDC Dardel (see run_dardel.sh)
//   -profile mac      Apple Silicon Mac, containers in the Lima VM (see conf/mac.config)
//   -profile offline  air-gapped Slurm + Apptainer cluster, nothing downloaded (docs/OFFLINE.md)
//   -profile bianca   offline, with UPPMAX Bianca's partitions and node sizes
//
// The MiXCR licence is a Nextflow secret, never a param:
//   nextflow secrets set MI_LICENSE <key>

params {
    // --- Samples ----------------------------------------------------------------
    // A samplesheet (see main.nf) replaces the single example sample below.
    samplesheet = null

    sample_id = 'sc5p_v2_hs_B_1k'

    // 10x "1k B cells, 5' v2, GEX + BCR". The tarball unpacks to one directory per
    // library; `libraries` maps each to its Cell Ranger multi row.
    fastq_url = 'https://cf.10xgenomics.com/samples/cell-vdj/6.0.0/sc5p_v2_hs_B_1k_multi_5gex_b_Multiplex/sc5p_v2_hs_B_1k_multi_5gex_b_Multiplex_fastqs.tar'
    fastq_dir = null    // an already unpacked copy; skips the download
    libraries = [
        [fastq_id: 'sc5p_v2_hs_B_1k_5gex', subdir: 'sc5p_v2_hs_B_1k_5gex_fastqs', feature_types: 'Gene Expression'],
        [fastq_id: 'sc5p_v2_hs_B_1k_b',    subdir: 'sc5p_v2_hs_B_1k_b_fastqs',    feature_types: 'VDJ-B'],
    ]

    // --- References (downloaded once into store_dir unless a path is given) -----
    gex_ref_url   = 'https://cf.10xgenomics.com/supp/cell-exp/refdata-gex-GRCh38-2024-A.tar.gz'
    vdj_ref_url   = 'https://cf.10xgenomics.com/supp/cell-vdj/refdata-cellranger-vdj-GRCh38-alts-ensembl-7.1.0.tar.gz'
    gex_reference = null
    vdj_reference = null
    // TRUST4's germline FASTAs (hg38_bcrtcr.fa, human_IMGT+C.fa); downloaded unless given.
    trust4_reference = null

    // Germline references: 'default' = each method's usual reference; 'imgt' = IMGT
    // for every method through its own published route (modules/local/imgt_reference.nf).
    reference_set      = 'default'
    // A URL (downloaded into store_dir) or a local path.
    mixcr_imgt_library = 'https://github.com/repseqio/library-imgt/releases/download/v8/imgt.202312-3.sv8.json.gz'
    // A Cell Ranger IMGT reference already built (mkvdjref output); skips fetch-imgt.
    imgt_reference     = null

    // --- Tools ------------------------------------------------------------------
    // Cell Ranger cannot be redistributed in a container, so it runs from a local
    // install on the host. Directory containing the `cellranger` executable.
    cellranger_dir         = null
    immcantation_container = 'immcantation/suite:4.4.0'
    mixcr_container        = 'ghcr.io/milaboratory/mixcr/mixcr:4.7.0'
    // MiXCR checks its licence online; skip it where tasks have no internet.
    skip_mixcr             = false
    skip_trust4            = false
    trust4_container       = 'quay.io/biocontainers/trust4:1.1.10--h5814d7d_0'
    trust4_ref_version     = 'v1.1.10'   // git tag of github.com/liulab-dfci/TRUST4 for the germline FASTAs
    // TRUST4 also on the GEX libraries (no VDJ enrichment), reported as trust4_gex.
    trust4_gex             = true
    // Ambient-chain filter for TRUST4, per barcode (see bin/vdj_compare.py).
    trust4_min_umis        = 3
    trust4_min_frac        = 0.1
    trust4_gex_min_umis    = 1
    // scanpy 1.12 + scikit-image (Scrublet's automatic threshold) + quarto, frozen
    // with Wave from containers/python_env.yml (linux/amd64 SIF).
    python_container       = 'oras://community.wave.seqera.io/library/python_scanpy_scikit-image_scikit-learn_pruned:dd4b1b2c537a5c1c'

    // --- Expression check -------------------------------------------------------
    markers   = "${projectDir}/assets/markers.tsv"
    // Marker scores: UCell, with maxRank = median detected genes unless set here.
    score_method = 'ucell'
    max_rank     = null
    // Score floors, also the thresholds when a score is not bimodal (see
    // expression_check.py). null = UCell 0.2 for T and 0.15 for B, scanpy 0.1.
    score_min    = null
    score_min_b  = null
    // Distinct marker genes of a set that must be detected for a positive call.
    min_markers = 3

    // --- Clone-level comparison ---------------------------------------------------
    // CDR3 amino-acid identity for joining clonotypes into a lineage (clone_compare.py).
    lineage_identity = 0.85

    // --- Paths ------------------------------------------------------------------
    store_dir = "${projectDir}/data/store"
    outdir    = "${projectDir}/results"

    // --- Offline (set by -profile offline/bianca) ----------------------------------
    // Nothing is downloaded: references must be given or be in store_dir, and images
    // in container_cache (main.nf checks both before starting).
    offline         = false
    container_cache = null
    // MiXCR checks its licence online: offline, it runs only with this set (a licence
    // from MiLaboratories that works offline); otherwise use --skip_mixcr.
    mixcr_offline_licence  = false
    // Slurm and containers in conf/offline.config; conf/bianca.config sets them for Bianca.
    slurm_account          = null   // sbatch -A
    slurm_queue            = null   // partition for every task
    slurm_queue_cellranger = null   // partition for Cell Ranger (16 CPUs, 64 GB)
    slurm_options          = ''     // anything else for sbatch
    slurm_mem_per_cpu      = false  // --mem-per-cpu instead of --mem
    max_cpus               = 16     // the largest job a node takes; requests are capped to it
    max_memory             = '120 GB'
    max_time               = '240h'
    container_engine       = 'apptainer'   // or 'singularity'
    container_options      = ''            // e.g. '-B /proj' if a container cannot see a path
}

includeConfig 'conf/base.config'

profiles {
    test {
        includeConfig 'conf/test.config'
    }
    dardel {
        includeConfig 'conf/dardel.config'
    }
    mac {
        includeConfig 'conf/mac.config'
    }
    offline {
        includeConfig 'conf/offline.config'
    }
    bianca {
        includeConfig 'conf/bianca.config'
        includeConfig 'conf/offline.config'
    }
}

manifest {
    name            = 'vdjTester'
    description     = 'Compare VDJ callers on 10x data and check them against expression-based B/T identity'
    nextflowVersion = '>=25.10.0'
}
