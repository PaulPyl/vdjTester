// vdjTester: compare VDJ callers (Cell Ranger multi, Immcantation, MiXCR) on one 10x
// sample, and check their calls against B/T identity from the matched expression data.
//
// Profiles:
//   -profile test     stub runs on the laptop, no containers (use with -stub)
//   -profile dardel   Slurm + Apptainer on PDC Dardel (see run_dardel.sh)
//
// The MiXCR licence is a Nextflow secret, never a param:
//   nextflow secrets set MI_LICENSE <key>

params {
    // --- Sample -----------------------------------------------------------------
    sample_id = 'sc5p_v2_hs_B_1k'

    // 10x "1k B cells, 5' v2, GEX + BCR". The tarball unpacks to one directory per
    // library; `libraries` maps each to its Cell Ranger multi row.
    fastq_url = 'https://cf.10xgenomics.com/samples/cell-vdj/6.0.0/sc5p_v2_hs_B_1k_multi_5gex_b_Multiplex/sc5p_v2_hs_B_1k_multi_5gex_b_Multiplex_fastqs.tar'
    fastq_dir = null    // an already unpacked copy; skips the download
    libraries = [
        [fastq_id: 'sc5p_v2_hs_B_1k_5gex', subdir: 'sc5p_v2_hs_B_1k_5gex_fastqs', feature_types: 'Gene Expression'],
        [fastq_id: 'sc5p_v2_hs_B_1k_b',    subdir: 'sc5p_v2_hs_B_1k_b_fastqs',    feature_types: 'VDJ-B'],
    ]

    // --- References (downloaded once into store_dir unless a path is given) -----
    gex_ref_url   = 'https://cf.10xgenomics.com/supp/cell-exp/refdata-gex-GRCh38-2024-A.tar.gz'
    vdj_ref_url   = 'https://cf.10xgenomics.com/supp/cell-vdj/refdata-cellranger-vdj-GRCh38-alts-ensembl-7.1.0.tar.gz'
    gex_reference = null
    vdj_reference = null

    // --- Tools ------------------------------------------------------------------
    // Cell Ranger cannot be redistributed in a container, so it runs from a local
    // install on the host. Directory containing the `cellranger` executable.
    cellranger_dir         = null
    immcantation_container = 'immcantation/suite:4.4.0'
    mixcr_container        = 'ghcr.io/milaboratory/mixcr/mixcr:4.7.0'
    // nf-core/scdownstream's scanpy 1.12 image, as used in G_Nordmark_nextflow.
    python_container       = 'https://community-cr-prod.seqera.io/docker/registry/v2/blobs/sha256/45/45339bf761a2cf0cdb058492bc37f3df8b05b363731d491d1d3a14e9ba0b8f55/data'

    // --- Expression check -------------------------------------------------------
    markers   = "${projectDir}/assets/markers.tsv"
    // Score threshold used when a marker score is not bimodal (see expression_check.py).
    score_min = 0.1

    // --- Paths ------------------------------------------------------------------
    store_dir = "${projectDir}/data/store"
    outdir    = "${projectDir}/results"
}

includeConfig 'conf/base.config'

profiles {
    test {
        includeConfig 'conf/test.config'
    }
    dardel {
        includeConfig 'conf/dardel.config'
    }
}

manifest {
    name            = 'vdjTester'
    description     = 'Compare VDJ callers on 10x data and check them against expression-based B/T identity'
    nextflowVersion = '>=25.10.0'
}
