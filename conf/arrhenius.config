// NAISS Arrhenius (Linköping): Slurm + Apptainer on the x86_64 `cpu` partition.
// Launch through run_arrhenius.sh (`sbatch run_arrhenius.sh`, or run it directly
// in tmux on the login node for -stub).
//
// Allocation naiss2026-4-384-cpu: NBIS internal project for testing and benchmarking
// tools on non-sensitive data (public GEO/ENA data here). Files under the majoris2025
// storage project. The `gpu` partition is aarch64 (GH200): none of these tools run
// there, and it needs the -gpu account anyway.

params {
    arrhenius_account = 'naiss2026-4-384-cpu'
    // Outside the repo so a fresh clone keeps the downloads.
    store_dir         = '/nobackup/proj/disk/majoris2025/personal/paulpyl/vdjTester_store'
    cellranger_dir    = '/nobackup/proj/disk/majoris2025/personal/paulpyl/vdjTester/tools/cellranger-10.0.0'
}

process {
    executor       = 'slurm'
    queue          = 'cpu'
    clusterOptions = "-A ${params.arrhenius_account}"

    // Nodes have 256 cores and ~755 GB; the partition shares nodes between jobs.
    withLabel: 'process_cellranger' {
        cpus   = 32
        memory = 128.GB
        time   = { 6.h * task.attempt }
    }
    // Compute nodes have internet (GitHub, ENA, 10x, MiXCR's licence server), so
    // downloads and MiXCR run as ordinary jobs, unlike on Dardel.
    withName: 'FETCH_ENA' {
        time = 24.h
    }
    // Not 'MIXCR|MIXCR_IMGT': Nextflow 25.10 lets a block with the same selector as
    // base.config replace that one (dropping its container) instead of merging.
    withName: 'MIXCR.*' {
        // MiXCR writes to $HOME and a cache dir; give it a writable overlay.
        containerOptions = '--writable-tmpfs'
    }
}

executor {
    queueSize = 50
}

apptainer {
    enabled     = true
    autoMounts  = true
    // Project storage is not bind-mounted by default. Apptainer refuses images under
    // $HOME, so the cache lives in the project.
    runOptions  = '-B /nobackup'
    cacheDir    = "${projectDir}/container_cache/nextflow"
    pullTimeout = '60m'
}
