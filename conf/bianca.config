// UPPMAX Bianca (sensitive data, no internet): params read by conf/offline.config,
// which -profile bianca includes after this file.
// Node sizes and partitions as UPPMAX documents them; check the current docs
// (https://docs.uppmax.uu.se) before a large run.
//   * compute nodes: 16 cores, 128 GB; on `core` memory comes with cores (~8 GB each)
//   * partitions: `core` (cores of a node), `node` (whole nodes); 10 days at most
//   * the project (sens20XXNNN) is the Slurm account: --slurm_account sens20XXNNN
//   * `singularity` is installed system-wide (Apptainer provides it as well)

params {
    slurm_queue            = 'core'
    slurm_queue_cellranger = 'node'
    max_cpus               = 16
    max_memory             = '120 GB'
    max_time               = '240h'
    container_engine       = 'singularity'
}
