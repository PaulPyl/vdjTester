// Stub runs on the laptop: nextflow run . -profile test -stub
// No containers, and a separate store so stub outputs can never be mistaken
// for real downloads in data/store.

params {
    store_dir = "${projectDir}/results_test/store"
    outdir    = "${projectDir}/results_test"
}

docker.enabled      = false
apptainer.enabled   = false
singularity.enabled = false
// Also after -profile offline/bianca (e.g. -profile bianca,test), which use Slurm.
process.executor    = 'local'

// Stubs do no work: cap every request, so a 16-CPU / 64 GB Cell Ranger stub does not
// wait for a machine's whole capacity to be free.
process.resourceLimits = [cpus: 2, memory: 4.GB, time: 1.h]
