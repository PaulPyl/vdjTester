// Air-gapped HPC: Slurm + Apptainer/Singularity, no internet on any node (UPPMAX
// Bianca: -profile bianca adds its partitions and node sizes). See docs/OFFLINE.md.
//
// Everything comes from an offline bundle (bin/make_offline_bundle.sh, unpacked with
// the bundle's unpack.sh): references in store/, container images in containers/,
// Cell Ranger in tools/cellranger. Nothing is downloaded: main.nf stops before
// starting if a reference is neither given as a path nor in store_dir, or an image is
// missing from container_cache, and names the file to stage.
//
// Launch with NXF_OFFLINE=true, so Nextflow itself never tries to reach the network:
//   NXF_OFFLINE=true nextflow run vdjTester -profile bianca --bundle_dir <dir> \
//       --slurm_account <project> --samplesheet <csv> --outdir <dir>
//
// Slurm and container settings are params (defaults in nextflow.config), so a site
// profile such as conf/bianca.config, included before this file, can set them.

params {
    offline         = true
    // The unpacked bundle. Each part can also be given on its own (store_dir,
    // container_cache, cellranger_dir), e.g. a Cell Ranger already on the system.
    bundle_dir      = null
    store_dir       = params.bundle_dir ? "${params.bundle_dir}/store" : "${projectDir}/data/store"
    container_cache = params.bundle_dir ? "${params.bundle_dir}/containers" : null
    cellranger_dir  = params.bundle_dir ? "${params.bundle_dir}/tools/cellranger" : null
}

process {
    executor       = 'slurm'
    queue          = params.slurm_queue
    clusterOptions = [params.slurm_account ? "-A ${params.slurm_account}" : '', params.slurm_options].findAll().join(' ')
    resourceLimits = [
        cpus  : params.max_cpus as int,
        memory: params.max_memory as nextflow.util.MemoryUnit,
        time  : params.max_time as nextflow.util.Duration,
    ]

    // Cell Ranger runs from cellranger_dir on the compute node, not in a container
    // (10x does not allow redistributing it), as on Dardel.
    withLabel: 'process_cellranger' {
        queue = params.slurm_queue_cellranger ?: params.slurm_queue
    }
}

executor {
    queueSize           = 20
    perCpuMemAllocation = params.slurm_mem_per_cpu
}

// Images are looked up in container_cache under the names Nextflow gives them
// (immcantation-suite-4.4.0.img, ...), which is how the bundle stores them. A missing
// one would be pulled, and fail without network; main.nf checks for them first.
apptainer {
    enabled    = params.container_engine == 'apptainer'
    autoMounts = true
    cacheDir   = params.container_cache
    runOptions = params.container_options
}
singularity {
    enabled    = params.container_engine == 'singularity'
    autoMounts = true
    cacheDir   = params.container_cache
    runOptions = params.container_options
}
