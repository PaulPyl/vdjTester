// Apple Silicon Mac: Nextflow on macOS, containers in the Lima `apptainer` VM
// through /usr/local/bin/apptainer, with Rosetta running the amd64 images.
//
// One-time setup (all gitignored):
//   tools/cellranger-10.0.0   Cell Ranger, run inside an amd64 Ubuntu container
//                             (the ARM VM has no x86 loader of its own)
//   tools/mixcr-4.7.0         MiXCR release zip; runs natively on macOS, because
//                             limactl drops APPTAINERENV_* so the licence secret
//                             never reaches a container
//   container_cache/nextflow  amd64 images, pre-pulled with `apptainer pull --arch
//                             amd64` (or copied from Dardel): ubuntu-22.04.img,
//                             immcantation-suite-4.4.0.img, the scanpy image.
//                             A plain Nextflow pull in the ARM VM picks arm64
//                             variants of multi-arch images.
//
// The project lives on /Volumes/vdj (APFS volume on the Extreme Pro SSD), with a
// link at ~/Projects/Science/vdjTester. The VM mounts ~ and /Volumes/vdj only, so
// the work dir must live under one of them.

params {
    fastq_dir           = "${projectDir}/data/dataset-vdj-practice/sc5p_v2_hs_B_1k_multi_5gex_b_fastqs"
    cellranger_dir      = '/opt/cellranger'          // inside the container
    cellranger_host_dir = "${projectDir}/tools/cellranger-10.0.0"
    mixcr_dir           = "${projectDir}/tools/mixcr-4.7.0"
    project_volume      = '/Volumes/vdj'
}

// Budget for all concurrent tasks. Containers share the VM's 8 CPUs; MiXCR runs
// natively on the host, so 12 lets it run alongside a 1-CPU download or a VM task.
// Memory: the VM has 40 GiB (lima.yaml), leaving macOS ~24 GB. With 56 GiB the
// VM's file cache pushed the Mac into heavy swapping (up to 3 GB/min, 2026-10-16).
executor {
    name   = 'local'
    cpus   = 12
    memory = '40 GB'
}

process {
    executor = 'local'

    withLabel: 'process_cellranger' {
        // Peak on cll_1: two or three alignment chunks of ~15 GB each. Cell Ranger
        // queues chunks to fit its --localmem, so 32 GB keeps it to two.
        cpus   = 8
        memory = 32.GB
        time   = { 8.h * task.attempt }
    }
    withLabel: 'process_medium' {
        cpus   = 8
        memory = 16.GB
    }

    withName: 'CELLRANGER_MULTI|FETCH_IMGT|MKVDJREF_IMGT' {
        container        = 'ubuntu:22.04'
        containerOptions = "-B ${params.cellranger_host_dir}:/opt/cellranger"
    }
    withName: 'MIXCR|MIXCR_IMGT' {
        cpus         = 8
        memory       = 8.GB
        container    = null
        beforeScript = "export PATH=${params.mixcr_dir}:\$PATH"
    }
    withName: 'MIXCR_LIBRARY_IMGT' {
        container    = null
        beforeScript = "export PATH=${params.mixcr_dir}:\$PATH"
    }
}

apptainer {
    enabled    = true
    autoMounts = true
    // Inputs are symlinks into data/ and the store; bind the whole home and the
    // project volume so the resolved paths exist inside the container. The VM
    // mounts both (~/.lima/apptainer/lima.yaml).
    runOptions = "-B ${System.getenv('HOME')} -B ${params.project_volume}"
    cacheDir   = "${projectDir}/container_cache/nextflow"
}
