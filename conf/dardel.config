// PDC Dardel: Slurm + Apptainer. Launch through run_dardel.sh, which also keeps
// Apptainer's own caches out of $HOME.
//
// Same allocation and storage as G_Nordmark_nextflow: compute on naiss2026-4-384
// (NBIS support), files under uppstore2017171 (~/Projects/WABI_Common links there).

params {
    dardel_account = 'naiss2026-4-384'
    // Outside the repo so a fresh clone keeps the downloads.
    store_dir      = '/cfs/klemming/projects/supr/uppstore2017171/paulpyl/data/vdjTester_store'
    cellranger_dir = '/cfs/klemming/projects/supr/uppstore2017171/paulpyl/tools/cellranger-10.0.0'
}

process {
    executor       = 'slurm'
    clusterOptions = "-A ${params.dardel_account}"
    // apptainer is not on PATH in a batch job, and Nextflow itself invokes it.
    beforeScript   = 'module load PDC/26.03 apptainer/1.5.1-cpeGNU-26.03'

    // `shared` allocates cores; `main` allocates whole nodes (128 cores, ~220 GB
    // usable) and charges for all of them, so only Cell Ranger goes there.
    queue = 'shared'

    withLabel: 'process_cellranger' {
        queue  = 'main'
        cpus   = 64
        memory = 200.GB
        time   = { 4.h * task.attempt }
    }
    // Compute nodes have no outbound internet (measured 2026-10-16 on `shared`:
    // 10x, zenodo.org and github.com all unreachable), so downloads run on the
    // login node, where the Nextflow driver is.
    withName: 'FETCH_TAR|FETCH_ENA' {
        executor     = 'local'
        beforeScript = ''
    }
    withName: 'MIXCR' {
        // MiXCR also verifies its licence online and fails on compute nodes with
        // "License error: ConnectionError". Use --skip_mixcr here until that's solved.
        // MiXCR writes to $HOME and a cache dir; give it a writable overlay.
        containerOptions = '--writable-tmpfs'
    }
}

executor {
    queueSize = 20
}

apptainer {
    enabled    = true
    autoMounts = true
    // /cfs is not bind-mounted by default; the project, inputs and work dir live there.
    runOptions = '-B /cfs'
    cacheDir   = "${projectDir}/container_cache/nextflow"
    // Converting the Immcantation suite image unpacks thousands of files onto
    // Lustre and took over 20 min (the default limit) on 2026-10-15.
    pullTimeout = '60m'
}
