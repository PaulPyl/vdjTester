// One-off override for resuming runs whose Cell Ranger tasks finished under the
// earlier 44 GB setting. --localmem is part of Cell Ranger's command, so the 32 GB
// cap in mac.config would rerun them. Use: -c conf/resume_cr44.config
process {
    withLabel: 'process_cellranger' {
        memory = 44.GB
    }
}
executor {
    memory = '48 GB'
}
