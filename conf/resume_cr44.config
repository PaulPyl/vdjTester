// Override for resuming runs that include cll_1, whose Cell Ranger tasks finished
// under the earlier 44 GB setting. --localmem is part of Cell Ranger's command, so
// the 32 GB cap in mac.config would rerun them; every other sample keeps 32 GB.
// Use: -c conf/resume_cr44.config
process {
    withLabel: 'process_cellranger' {
        memory = { sample_id.startsWith('cll_1_') ? 44.GB : 32.GB }
    }
}
executor {
    memory = '48 GB'
}
