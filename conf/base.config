// Resources and containers shared by every profile.
//
// Every limit escalates with task.attempt: Slurm reserves against the declared
// time, so start small and grow on retry rather than declaring a worst case.
// 140 is a Slurm TIMEOUT on Dardel, 137/143 are OOM/SIGTERM.

process {
    errorStrategy = { task.exitStatus in [137, 140, 143] && task.attempt <= 2 ? 'retry' : 'terminate' }
    maxRetries    = 2

    withLabel: 'process_single' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }
    withLabel: 'process_low' {
        cpus   = 4
        memory = { 16.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }
    withLabel: 'process_medium' {
        cpus   = 8
        memory = { 32.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }
    withLabel: 'process_cellranger' {
        cpus   = 16
        memory = { 64.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    // ENA downloads: a 13 GB GEX library took 3-4 h at the ~1 MB/s ENA gave on
    // 2026-10-16, past process_single's 2 h. They run locally, never on Slurm.
    withName: 'FETCH_ENA' {
        time = 24.h
    }
    withName: 'IMMCANTATION' {
        container = params.immcantation_container
    }
    // afterScript removes intermediates once a task has succeeded, leaving the
    // declared outputs. On cll_1 they were 2.8 GB of .mic files per MiXCR library and
    // ~4 GB per TRUST4 task. afterScript is not part of the task hash, so cached
    // tasks stay valid.
    withName: 'MIXCR' {
        container   = params.mixcr_container
        afterScript = 'rm -f *.mic *.vdjca *.clna'
    }
    withName: 'TRUST4' {
        container   = params.trust4_container
        afterScript = 'rm -rf out'
    }
    withName: 'COMPARE_VDJ|EXPRESSION_CHECK|CLONE_TRACKING|REPORT' {
        container = params.python_container
    }
}
